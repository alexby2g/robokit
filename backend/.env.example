APP_NAME=ROBOKIT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-RENDER-SERVICE.onrender.com
FRONTEND_URL=https://YOUR-VERCEL-PROJECT.vercel.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=YOUR-NEON-HOST
DB_PORT=5432
DB_DATABASE=YOUR-NEON-DATABASE
DB_USERNAME=YOUR-NEON-USER
DB_PASSWORD=YOUR-NEON-PASSWORD
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=YOUR-VERCEL-PROJECT.vercel.app

FILESYSTEM_DISK=public

# Cloudflare R2 (Render / producción)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_PUBLIC_BUCKET=robokit-public
AWS_PRIVATE_BUCKET=robokit-private
AWS_PUBLIC_URL=https://pub-TU_ID.r2.dev
AWS_USE_PATH_STYLE_ENDPOINT=true
PUBLIC_FILESYSTEM_DRIVER=s3
PRIVATE_FILESYSTEM_DRIVER=s3

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@robokit.app
MAIL_FROM_NAME=ROBOKIT
